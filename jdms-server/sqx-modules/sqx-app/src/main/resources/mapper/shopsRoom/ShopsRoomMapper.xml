<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sqx.app.base.shopsRoom.dao.ShopsRoomDao">

    <select id="getRoomTypeList" resultType="java.util.Map">
        SELECT room_type_id as roomTypeId,room_type as roomType FROM `shops_room`
        <where>
            <if test="type==1">
                is_enable=1
            </if>
        </where>
        GROUP BY room_type
    </select>
</mapper>
