  "copywritingGuidelines": {
    "tone": "温和、简洁、像前台接待而非系统通知",
    "examples": {
      "formTitle": {
        "bad": "填写信息",
        "good": "告诉我们要怎么联系您"
      },
      "placeholder": {
        "bad": "请输入姓名",
        "good": "您的真实姓名（与证件一致）"
      },
      "submit": {
        "bad": "提交",
        "good": "确认预订 / 保存信息 / 申请开票"
      },
      "empty": {
        "bad": "暂无数据",
        "good": "还没有订单，去挑一家心仪民宿吧"
      }
    }
  },

  "qualityChecklist": {
    "visual": [
      "页面背景 #F6F8FB，卡片 #FFFFFF + #EEF1F6 边框",
      "无 box-shadow（Logo 除外且仅 g-shadow-soft）",
      "主字重不超过 600",
      "价格/错误色 #FB7185，非 #EF4444",
      "按钮渐变 #7EBAFF → #2C8EFE，圆角 pill"
    ],
    "form": [
      "无左标签列宽表格布局",
      "每表单页有标题 + 至少一句 hint",
      "字段间距 >= 26rpx",
      "底部提交区有 safe-area",
      "picker 类字段右对齐 + chevron"
    ],
    "product": [
      "核心链路 3 步内可达下单",
      "表单字段数可见分组，单组 <= 5 项",
      "空态有行动引导（按钮或链接）",
      "商家端效率不降：核销/订单列表信息密度可高于用户端"
    ],
    "technical": [
      "仅改 template/style，script 业务逻辑零 diff",
      "使用 guest-* / host-* 类名，不引入 plat-* / tk-*",
      "scoped 样式不硬编码 #111827 / #EF4444",
      "theme-soft.css 作为最后覆写层"
    ]
  },

