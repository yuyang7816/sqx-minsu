{
  "planMeta": {
    "projectName": "hotel_jiudianminsu",
    "projectType": "uni-app 酒店民宿双端（用户端 + 商家端）",
    "planVersion": "1.0.0",
    "createdAt": "2026-07-16",
    "authorRole": ["高级UI设计师", "高级产品经理"],
    "designCodename": "Azure Stay · 温润入住",
    "constraint": "仅改 template / style，不改接口、跳转、支付、地图、核销等业务逻辑",
    "cssArchitecture": {
      "loadOrder": [
        "uni_modules/uview-plus/index.scss",
        "static/css/main.css",
        "style/main.scss",
        "static/css/guest.css",
        "static/css/host.css",
        "static/css/theme-soft.css"
      ],
      "namingSpace": {
        "guest": "用户端 guest-*",
        "host": "商家端 host-*",
        "pageLocal": "页面专属前缀 hd-* / rl-* / home-*（仅局部布局）"
      },
      "deprecated": ["plat-*", "tk-*", "platform.css", "toolkit.css"]
    }
  },

  "productVision": {
    "oneLiner": "像预订一间舒适民宿一样轻松——轻、柔、留白足、边框细、渐变温润",
    "userEmotion": ["安心", "放松", "被欢迎", "不被打扰"],
    "antiPatterns": [
      "管理后台式左标签右输入表格",
      "厚重卡片阴影与粗黑字重",
      "商城促销红与硬直角",
      "信息密度过高的 B 端表格感",
      "无引导语的裸表单"
    ],
    "coreJourneys": [
      {
        "id": "J1",
        "name": "发现与预订",
        "path": "首页 → 搜索 → 详情 → 房型 → 确认订单 → 支付",
        "priority": "P0"
      },
      {
        "id": "J2",
        "name": "订单履约",
        "path": "订单列表 → 订单详情 → 评价 / 开票",
        "priority": "P0"
      },
      {
        "id": "J3",
        "name": "账户与资产",
        "path": "我的 → 钱包 / 会员 / 优惠券 / 设置",
        "priority": "P1"
      },
      {
        "id": "J4",
        "name": "商家经营",
        "path": "商家中心 → 订单核销 → 房源管理 → 员工协作 → 商家钱包",
        "priority": "P1"
      }
    ]
  },

