    }
  },

  "layoutTemplates": {
    "T1_heroFloat": {
      "desc": "渐变头区 + 浮层白卡（首页/我的）",
      "structure": ["guest-hero", "guest-search / guest-card 负 margin 上浮"],
      "usage": ["pages/index/index", "pages/my/index"]
    },
    "T2_feedList": {
      "desc": "信息流列表，白底 + 分割线，无卡片阴影",
      "structure": ["section-head", "list-item + divider"],
      "usage": ["pages/index/search", "subpackage/hotel/roomList", "subpackage/hotel/hotelDetail"]
    },
    "T3_tabList": {
      "desc": "顶部分段 + 列表（订单/筛选）",
      "structure": ["guest-sticky tabs", "guest-order-card / guest-list-card"],
      "usage": ["pages/order/index", "shopCenter/order/index"]
    },
    "T4_detailFlow": {
      "desc": "详情纵向信息流 + 底部固定操作栏",
      "structure": ["media", "info-blocks", "guest-fixed-foot"],
      "usage": ["subpackage/hotel/hotelDetail", "subpackage/hotel/roomDetail", "subpackage/order/orderDetail"]
    },
    "T5_formStay": {
      "desc": "住宿感表单（非后台表格）",
      "structure": ["guest-auth__head 或 guest-form-head", "guest-stay-form", "guest-btn 提交"],
      "usage": "所有填写类页面，见 formDesignSystem"
    },
    "T6_hostConsole": {
      "desc": "商家工作台：数据顶栏 + 面板网格",
      "structure": ["host-top", "host-metrics", "host-panel grid"],
      "usage": ["shopCenter/index/index"]
    },
    "T7_hostTool": {
      "desc": "商家工具页：密度略高但仍保持细边框无阴影",
      "structure": ["host-block", "host-order-card", "host-foot"],
      "usage": ["shopCenter/order/*", "shopCenter/rooms/*", "shopCenter/employee/*"]
    }
  },

  "formDesignSystem": {
    "philosophy": "表单是「填写入住信息」，不是「录入系统数据」",
    "principles": [
      "去掉左侧固定标签列，改用 placeholder + 顶部轻提示语",
      "一屏一个意图：标题说明「为什么填」",
      "字段之间用细分割线，不用表格边框",
      "必填不标红星暴力提示，用柔和 helper text",
      "提交按钮使用胶囊渐变，与页面留白形成呼吸感",
      "商家端表单同样禁止 B 端表格化，仅允许信息密度略高"
    ],
    "patterns": {
      "guest-auth": {
        "适用": "账号类：登录 / 注册 / 忘记密码 / 改密",
        "结构": ["Logo", "标题", "hint", "guest-auth__form（无边框阴影）", "主按钮", "底部链接"],
        "status": "已落地",
        "files": [
          "pages/public/loginphone.vue",
          "pages/public/register.vue",
          "pages/public/forgetPwd.vue"
        ]
      },
      "guest-stay-form": {
        "适用": "交易与个人信息类表单",
        "结构": [
          "guest-form-head（图标/标题/一句引导）",
          "guest-stay-form（白底圆角容器）",
          "guest-stay-field（仅底部分割线）",
          "guest-stay-field__hint（可选）",
          "guest-fixed-foot 或 guest-btn 提交"
        ],
        "fieldRules": {
          "labelPosition": "none 或 field 内顶部小字",
          "inputStyle": "无边框，placeholder #94A3B8",
          "selectStyle": "右箭头 + 值右对齐",
          "textareaStyle": "最小高度 160rpx，圆角 muted 背景"
        },
        "status": "待新建 CSS 并批量迁移",
        "targetFiles": [
          "pages/my/userInfo.vue",
          "my/cyMsg/index.vue",
          "my/feedback/index.vue",
          "subpackage/hotel/comfirOrder.vue",
          "subpackage/invoice/kaipiao.vue",
          "subpackage/invoice/Invoicing.vue",
          "my/wallet/recharge.vue",
          "my/wallet/cash.vue",
          "my/wallet/zhifubao.vue",
          "my/shopRz/index.vue",
          "my/shopRz/shopCheck.vue",
          "package/setting/upPwd.vue"
        ]
      },
      "host-lite-form": {
        "适用": "商家录入：房源 / 员工 / 认证",
        "结构": [
          "host-form-head",
          "host-lite-form",
          "host-lite-field",
          "host-btn 提交"
        ],
        "差异": "字段间距略紧凑，但仍无左标签列",
        "status": "待新建 CSS 并迁移",
        "targetFiles": [
          "shopCenter/rooms/addRoom.vue",
          "shopCenter/employee/addEmployee.vue",
          "shopCenter/index/renzheng.vue"
        ]
      },
      "guest-picker-sheet": {
        "适用": "日期 / 城市 / 支付方式 / 优惠券选择",
        "structure": "底部弹层 + 胶囊选项，不用原生硬表格",
        "components": ["guest-chip", "guest-pay-opt", "home-search__tab"]
      }
    },
    "forbiddenPatterns": [
      "u-cell-group + 左 label 120rpx 右 input 后台布局",
      "每行灰色背景 + 粗边框表格",
      "required 红星 + 密集字段无分组",
      "提交按钮贴边无 safe-area",
      "表单页纯白底无任何品牌渐变过渡"
    ]
  },

